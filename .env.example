# This is a shared template for the whole series.
# Some tutorials won't need any env vars at all. Others will only need 1–2 keys.
# Copy to `.env` in the folder you are running (or set env vars in your shell).

# Common API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
GOOGLE_API_KEY=

# Retrieval / search tools
TAVILY_API_KEY=
EXA_API_KEY=

# Vector DBs
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=

# Local inference
OLLAMA_HOST=http://localhost:11434

# Knowledge graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Managed RAG providers
RAGIE_API_KEY=
CONTEXTUAL_API_KEY=
CONTEXTUAL_BASE_URL=https://api.contextual.ai/v1

# Optional: preload a single URL for 12_local_rag_agent_agno_ollama
RAG_SOURCE_URL=
